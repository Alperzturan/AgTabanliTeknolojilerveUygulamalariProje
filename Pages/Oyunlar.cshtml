@page
@model Michelangelo_s_Board_Game_Cafe.Pages.OyunlarModel
@{
    ViewData["Title"] = "Oyunlar";
}

<h1 class="
    d-flex
    justify-content-center">Kutu Oyunu Kütüphanesi</h1>

<div class="my-4 d-flex">
    <div class="input-group w-auto">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input class="search search-bar" type="search" placeholder="Bir oyun ara...">
    </div>
    <div class="dropdown ms-2 input-group w-auto">
        <button class="input-group-text dropdown-toggle" 
                data-bs-toggle="dropdown"
                data-bs-auto-close="outside">
            <i class="bi bi-funnel"></i>
        </button>
        <div class="dropdown-menu p-3 shadow">
            <div class="d-grid gap-3 text-nowrap" style="grid-template-columns: repeat(3, 1fr);">
                <div class="border-end pe-3">
                    <p class="fw-bold mb-1">Kategori</p>
                    @foreach (Models.Category cat in Model.Categories)
                    {
                        <div class="form-check">
                            <input class="form-check-input filter" 
                                type="checkbox" 
                                value="@cat.Name.ToLower()" 
                                name="category"
                                id="cat-@cat.Id">
                            <label class="form-check-label" for="cat-@cat.Id">@cat.Name</label>
                        </div>
                    }
                </div>
                <div class="border-end pe-3">
                    <p class="fw-bold mb-1">Zaman</p>
                    @{
                        (string, string)[]? zamanlar = new[] {
                            ("kisa", "Kısa (<30dk)"),
                            ("orta", "Orta (30-60dk)"),
                            ("uzun", "Uzun (>60dk)")
                        };
                    }
                    @foreach ((string? kod, string? etiket) in zamanlar)
                    {
                        <div class="form-check">
                            <input class="form-check-input filter" 
                                type="checkbox" 
                                value="@kod" 
                                name="time"
                                id="time-@kod">
                            <label class="form-check-label" for="time-@kod">@etiket</label>
                        </div>
                    }
                </div>
                <div>
                    <p class="fw-bold mb-1">Oyuncu Sayısı</p>
                    @{
                        (string, string)[]? oyuncular = new[] {
                            ("1-2", "1-2"),
                            ("3-4", "3-4"),
                            ("5+", "5+")
                        };
                    }
                    @foreach ((string? kod, string? etiket) in oyuncular)
                    {
                        <div class="form-check">
                            <input class="form-check-input filter" 
                                type="checkbox" 
                                value="@kod"
                                name="players"
                                id="player-@kod">
                            <label class="form-check-label" for="player-@kod">@etiket</label>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<div class="d-flex flex-wrap justify-content-center gap-5">
    @foreach (Models.BoardGame game in Model.BoardGames)
    {
        string sureKodu = game.PlayTimeMinutes <= 30 ? "kisa" : (game.PlayTimeMinutes <= 60 ? "orta" : "uzun");
        string oyuncuKodu = game.MaxPlayers <= 2 ? "1-2" : (game.MaxPlayers <= 4 ? "3-4" : "5+");

        <div class="game-cards"
            data-title="@game.Title.ToLower()"
            data-category="@game.Category?.Name.ToLower()"
            data-time="@sureKodu"
            data-players="@oyuncuKodu">
            <p class="badge-pos">@game.Category?.Name</p>
            <h5 class="d-flex justify-content-center fw-bold">@game.Title</h5>
            <img class="image" src="@game.ImageUrl" alt="resim">
            <div>
                <ul class="list-items-shape-games">
                    <li>@game.Description</li>
                    <li><i class="bi bi-people-fill"></i> : @game.MinPlayers - @game.MaxPlayers Kişi</li>
                    <li><i class="bi bi-clock"></i> : @game.PlayTimeMinutes dk</li>
                    <li><i class="bi bi-box-seam"></i> : @game.AvailableCopies Stok</li>
                </ul>
            </div>
            <button class="btn-shape-game btn-color-game" 
                    onclick="location.href='/OyunDetay?id=@game.Id'
                    ">Detaylı İncele</button>
        </div>
    }
</div>