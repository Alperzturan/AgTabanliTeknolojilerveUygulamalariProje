@page
@model Michelangelo_s_Board_Game_Cafe.Pages.OyunlarModel
@{
    ViewData["Title"] = "Oyunlar";
}

<h1 class="
    d-flex
    justify-content-center">Kutu Oyunu Kütüphanesi</h1>

<div class="my-4">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="input-group w-auto">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input class="search search-bar" type="search" placeholder="Bir oyun ara...">
        </div>
        <div class="dropdown input-group w-auto">
            <button class="input-group-text dropdown-toggle" 
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside">
                <i class="bi bi-funnel"></i>
            </button>
            <div class="dropdown-menu p-3 shadow">
                <div class="d-grid gap-3 text-nowrap" style="grid-template-columns: repeat(3, 1fr);">
                    <div class="border-end pe-3">
                        <p class="fw-bold mb-1">Kategori</p>
                        @foreach (Models.Category cat in Model.Categories)
                        {
                            <div class="form-check">
                                <input class="form-check-input filter" 
                                    type="checkbox" 
                                    value="@cat.Name.ToLower()" 
                                    name="category"
                                    id="cat-@cat.Id">
                                <label class="form-check-label" for="cat-@cat.Id">@cat.Name</label>
                            </div>
                        }
                    </div>
                    <div class="border-end pe-3">
                        <p class="fw-bold mb-1">Zaman</p>
                        @{
                            (string, string)[]? zamanlar = new[] {
                                ("kisa", "Kısa (<30dk)"),
                                ("orta", "Orta (30-60dk)"),
                                ("uzun", "Uzun (>60dk)")
                            };
                        }
                        @foreach ((string? kod, string? etiket) in zamanlar)
                        {
                            <div class="form-check">
                                <input class="form-check-input filter" 
                                    type="checkbox" 
                                    value="@kod" 
                                    name="time"
                                    id="time-@kod">
                                <label class="form-check-label" for="time-@kod">@etiket</label>
                            </div>
                        }
                    </div>
                    <div>
                        <p class="fw-bold mb-1">Oyuncu Sayısı</p>
                        @{
                            (string, string)[]? oyuncular = new[] {
                                ("1-2", "1-2"),
                                ("3-4", "3-4"),
                                ("5+", "5+")
                            };
                        }
                        @foreach ((string? kod, string? etiket) in oyuncular)
                        {
                            <div class="form-check">
                                <input class="form-check-input filter" 
                                    type="checkbox" 
                                    value="@kod"
                                    name="players"
                                    id="player-@kod">
                                <label class="form-check-label" for="player-@kod">@etiket</label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <button id="clearFiltersBtn" type="button" class="btn-clear-filters d-none">
            <i class="bi bi-x-circle"></i> Filtreleri Temizle
        </button>
    </div>

    <div class="mt-2">
        <span id="gameCountText" class="catalog-count-badge d-inline-block">
            <i class="bi bi-grid-fill"></i> @Model.BoardGames.Count oyun listeleniyor
        </span>
    </div>
</div>
<div class="d-flex flex-wrap justify-content-center gap-5">
    @foreach (Models.BoardGame game in Model.BoardGames)
    {
        string sureKodu = game.PlayTimeMinutes <= 30 ? "kisa" : (game.PlayTimeMinutes <= 60 ? "orta" : "uzun");
        string oyuncuKodu = game.MaxPlayers <= 2 ? "1-2" : (game.MaxPlayers <= 4 ? "3-4" : "5+");
        bool hasImage = !string.IsNullOrWhiteSpace(game.ImageUrl);
        bool hasWiki = !string.IsNullOrWhiteSpace(game.WikiPageId);
        bool inStock = game.AvailableCopies > 0;

        <div class="game-cards"
            data-title="@game.Title.ToLower()"
            data-category="@game.Category?.Name.ToLower()"
            data-time="@sureKodu"
            data-players="@oyuncuKodu">
            <p class="badge-pos">@game.Category?.Name</p>
            @if (hasWiki)
            {
                <span class="wiki-badge" title="Wikipedia API'den çekildi">
                    <i class="bi bi-globe2"></i> Wiki
                </span>
            }
            <div class="game-title-wrapper mt-2">
                <h5 class="game-title-clamp fw-bold mb-0" title="@game.Title">@game.Title</h5>
            </div>

            <div class="game-cover-wrapper">
                @if (hasImage)
                {
                    <img class="image"
                         src="@game.ImageUrl"
                         alt="@game.Title kapak görseli"
                         loading="lazy"
                         onerror="this.classList.add('d-none'); this.nextElementSibling.classList.remove('d-none');">
                }
                <div class="image-fallback @(hasImage ? "d-none" : "")">
                    <i class="bi bi-dice-5-fill"></i>
                    <span>Görsel mevcut değil</span>
                </div>
            </div>

            <div class="flex-grow-1 d-flex flex-column">
                <p class="game-desc-clamp @(string.IsNullOrWhiteSpace(game.Description) ? "fst-italic text-muted" : "")">
                    @(string.IsNullOrWhiteSpace(game.Description)
                        ? "Bu oyun için henüz açıklama eklenmemiş."
                        : game.Description)
                </p>
                <ul class="list-items-shape-games mt-auto">
                    <li><i class="bi bi-people-fill"></i> : @game.MinPlayers - @game.MaxPlayers Kişi</li>
                    <li><i class="bi bi-clock"></i> : @game.PlayTimeMinutes dk</li>
                    <li>
                        <i class="bi bi-box-seam"></i> :
                        <span class="stock-pill @(inStock ? "stock-available" : "stock-out")">
                            @(inStock ? $"Müsait ({game.AvailableCopies}/{game.TotalCopies})" : "Tükendi")
                        </span>
                    </li>
                </ul>
            </div>

            <a class="btn-shape btn-color-game text-center text-decoration-none mt-2"
               asp-page="/OyunDetay"
               asp-route-id="@game.Id">Detaylı İncele</a>
        </div>
    }
</div>

<div id="noGamesMessage" class="empty-catalog-box @(Model.BoardGames.Count == 0 ? "" : "d-none")">
    <i class="bi bi-search"></i>
    <h4 class="fw-bold mt-2 mb-1">Aramanıza uygun oyun bulunamadı</h4>
    <p class="text-muted mb-3">Farklı bir oyun adı deneyebilir veya seçili filtreleri sıfırlayabilirsiniz.</p>
    <button type="button" class="btn-shape btn-color-detail js-reset-filters">
        <i class="bi bi-arrow-counterclockwise"></i> Filtreleri Temizle
    </button>
</div>