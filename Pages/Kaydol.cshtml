@page
@model Michelangelo_s_Board_Game_Cafe.Pages.KaydolModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<form class="membership-box" method="post">
    <h1>Kayıt Ol</h1>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="d-flex flex-column mx-4 my-3 justify-content-center">
        <div class="form-floating">
            <input asp-for="Input.FullName" class="form-control"  required type="text" id="ad" placeholder="">
            <label asp-for="Input.FullName" for="ad">ad-soyad</label>
            <span asp-validation-for="Input.FullName" class="text-danger"></span>
        </div>
        <div class="form-floating">
            <input asp-for="Input.Email" class="form-control" required type="email" id="email" placeholder="">
            <label asp-for="Input.Email" for="email">e-mail</label>
            <span  asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="form-floating">
            <input asp-for="Input.Phone" class="form-control"  type="tel" id="tel" placeholder="">
            <label asp-for="Input.Phone" for="tel">telefon numarası</label>
            <span asp-validation-for="Input.Phone" class="text-danger"></span>
        </div>
        <div class="form-floating">
            <input asp-for="Input.Password" class="form-control"  required minlength="6" type="password" id="pw" placeholder="">
            <label asp-for="Input.Password" for="pw">şifre</label>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="form-floating">
            <input asp-for="Input.ConfirmPassword" class="form-control" required type="password" id="pw-kontrol" placeholder="-">
            <label  asp-for="Input.ConfirmPassword"  for="pw-kontrol">şifre(tekrar)</label>
            <span  asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>          
    </div>
    <button class="btn-color btn-shape" type="submit">Kayıt Ol</button>
    <div class="d-flex my-2">
        <p class="d-flex align-items-center flex-grow-1 m-0 px-1">Zaten bir hesabın var mı?</p>
        <button class="btn-color btn-shape" type="button" onclick="location.href='/GirisYap'" formnovalidate>Giriş Yap</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
