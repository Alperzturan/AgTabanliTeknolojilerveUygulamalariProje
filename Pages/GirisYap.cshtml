@page
@model Michelangelo_s_Board_Game_Cafe.Pages.GirisYapModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<form class="membership-box" method="post">
    <h1>Giriş Yap</h1>

     <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="d-flex flex-column mx-4 my-3 justify-content-center">
        <div class="form-floating">
            <input asp-for="Input.Email" class="form-control"  required type="email" id="email" placeholder="">
            <label asp-for="Input.Email" for="email">e-mail</label>
            <span asp-validation-for="Input.Email"  class="text-danger"></span>
        </div>
        <div class="form-floating">
            <input asp-for="Input.Password" class="form-control" required type="password" id="pw" placeholder="">
            <label asp-for="Input.Password" for="pw">şifre</label>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="m-2">
            <input asp-for="Input.RememberMe" type="checkbox"  id="hatirla">
            <label for="hatirla">Beni Hatırla</label>
        </div>          
    </div>
    <button class="btn-color btn-shape m-0" type="submit">Giriş Yap</button>
    <div class="d-flex my-2">
        <p class="d-flex align-items-center flex-grow-1 m-0 px-1">Henüz üye değil misin?</p>
        <button class="btn-color btn-shape" type="button" onclick="location.href='/Kaydol'" formnovalidate>Kayıt Ol</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }