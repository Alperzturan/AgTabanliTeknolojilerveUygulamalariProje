@page
@model Michelangelo_s_Board_Game_Cafe.pages.GirisYapModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<form class="text-box" method="post">
    <h1>Giriş Yap</h1>
    <div class="d-flex flex-column mx-4 my-3 justify-content-center">
        <div class="form-floating">
            <input class="form-control" type="email" id="email" placeholder="">
            <label for="email">e-mail</label>
        </div>
        <div class="form-floating">
            <input class="form-control" type="password" id="pw" placeholder="">
            <label for="pw">şifre</label>
        </div>
        <div class="m-2">
            <input type="radio"" id="hatirla">
            <label for="hatirla">Beni Hatırla</label>
        </div>          
    </div>
    <button class="btn-color btn-shape m-0" type="submit">Giriş Yap</button>
    <div class="d-flex my-2">
        <p class="d-flex align-items-center flex-grow-1 m-0 px-1">Henüz üye değil misin?</p>
        <button class="btn-color btn-shape" asp-area="" asp-page="/Kaydol">Kayıt Ol</button>
    </div>
</form>
