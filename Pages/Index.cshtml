@page
@model IndexModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-box text-center ">
    <h1 class="fw-bold">Michelangelo's Board Game Cafe</h1>
    <p class="lead">Çeşitli oyunlar oynayabileceğiniz kafemizi daha kolay keşfedebilmeniz ve sıkıntı çekmeden masa rezerve edebilmeniz için geliştirdiğimiz websitemize hoşgeldiniz</p>
    <div class="list-items-shape">
        <button class="btn-color btn-shape">
            <a class="text-decoration-none text-color" asp-area="" asp-page="">Oyunları İncele</a>
        </button>
        <button class="btn-color btn-shape">
            <a class="text-decoration-none text-color" asp-area="" asp-page="">Masa Rezerve Et</a> 
        </button>
    </div>
</div>
<div class="
    list-items-shape
    d-flex
    flex-wrap
    ">
    <div class="
        text-box
        m-1">
        <p class="
            fw-bold
            fs-4">Oyun Kütüphanesini Keşfet</p>
        <p class="
            hidden-info
        ">Kafedeki kutu oyunlarını kategorisine ve oyuncu sayısına göre önceden incele.</p>
    </div>
    <div class="
        text-box
        m-1">
        <p class="
            fw-bold
            fs-4">Masanı ve Oyununu Ayırt</p>
        <p class="
            hidden-info
        ">Geleceğin tarih ve saati seçerek uygun masayı ve oynamak istediğin oyunu rezerve et.</p>
    </div>
    <div class="
        text-box
        m-1">
        <p class="
            fw-bold
            fs-4">Gamemaster Desteği</p>
        <p class="
            hidden-info
        ">Kafe çalışanlarımızdan oyun kuralları ve masa kurulumu konusunda anında destek al.</p>
    </div>
</div>

