@page
@model Michelangelo_s_Board_Game_Cafe.Pages.OyunDetayModel
@{
    ViewData["Title"] = "Oyun Detayları";
}

@if (Model.BoardGame != null) { 
    <div class="text-box d-flex flex-row gap-4">
        <p class="badge-pos fs-4 py-2 px-3">@Model.BoardGame.Category?.Name</p>
        <div class="d-flex justify-content-center w-50">
            <img class="img-fluid" src="@Model.BoardGame.ImageUrl" alt="GameImage">
        </div>
        <div class="d-flex flex-column justify-content-start w-50">
            <h1 class="fw-bold">@Model.BoardGame.Title</h1>
            <ul class="list-items-shape-games fs-4">
                <li class="mb-3">@Model.BoardGame.Description</li>
                <li><i class="bi bi-people-fill"></i> : @Model.BoardGame.MinPlayers - @Model.BoardGame.MaxPlayers Kişi</li>
                <li><i class="bi bi-clock"></i> : @Model.BoardGame.PlayTimeMinutes dk</li>
                <li><i class="bi bi-box-seam"></i> : @Model.BoardGame.AvailableCopies Stok</li>
            </ul>
            <div class="mt-3">
                <button type="button" class="btn-color-detail btn-shape" onclick="location.href='/Rezervasyon'">Masa Rezerve Et</button>
                <button type="button" class="btn-color-detail btn-shape" onclick="location.href='/Oyunlar'">Kütüphaneye Dön</button>
            </div>
        </div>
    </div>
}
