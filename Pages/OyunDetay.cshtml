@page
@model Michelangelo_s_Board_Game_Cafe.Pages.OyunDetayModel
@{
    ViewData["Title"] = Model.BoardGame?.Title ?? "Oyun Detayları";
}

@if (Model.BoardGame != null)
{
    var game = Model.BoardGame;
    bool hasImage = !string.IsNullOrWhiteSpace(game.ImageUrl);
    bool hasWiki = !string.IsNullOrWhiteSpace(game.WikiPageId);
    bool inStock = game.AvailableCopies > 0;
    int stockPercent = game.TotalCopies > 0
        ? Math.Clamp((int)Math.Round((double)game.AvailableCopies / game.TotalCopies * 100), 0, 100)
        : 0;
    bool isLongDesc = !string.IsNullOrWhiteSpace(game.Description) && game.Description.Length > 280;

    string? wikiUrl = null;
    if (hasWiki)
    {
        var rawWiki = game.WikiPageId!.Trim();
        if (rawWiki.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || rawWiki.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            wikiUrl = rawWiki;
        }
        else if (rawWiki.StartsWith("Q", StringComparison.OrdinalIgnoreCase) && rawWiki.Length > 1 && rawWiki[1..].All(char.IsDigit))
        {
            wikiUrl = $"https://www.wikidata.org/wiki/{rawWiki}";
        }
        else
        {
            wikiUrl = $"https://tr.wikipedia.org/?curid={rawWiki}";
        }
    }

    <div class="text-box detail-card">
        <p class="badge-pos fs-6 py-2 px-3">@game.Category?.Name</p>

        <div class="d-flex flex-column flex-md-row gap-4 mt-4">
            <div class="detail-cover-col">
                <div class="detail-cover-wrapper">
                    @if (hasImage)
                    {
                        <img class="detail-cover-img"
                             src="@game.ImageUrl"
                             alt="@game.Title kapak görseli"
                             loading="lazy"
                             onerror="this.classList.add('d-none'); this.nextElementSibling.classList.remove('d-none');">
                    }
                    <div class="image-fallback @(hasImage ? "d-none" : "")">
                        <i class="bi bi-dice-5-fill"></i>
                        <span>Görsel mevcut değil</span>
                    </div>
                </div>
            </div>

            <div class="detail-info-col d-flex flex-column">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <h1 class="fw-bold mb-0">@game.Title</h1>
                    <span class="stock-pill @(inStock ? "stock-available" : "stock-out")">
                        @(inStock ? "Müsait" : "Tükendi")
                    </span>
                </div>

                <div class="mb-3">
                    <p id="detailDesc" class="detail-description @(isLongDesc ? "detail-desc-collapsed" : "") @(string.IsNullOrWhiteSpace(game.Description) ? "fst-italic text-muted" : "")">
                        @(string.IsNullOrWhiteSpace(game.Description)
                            ? "Bu oyun için henüz açıklama eklenmemiş."
                            : game.Description)
                    </p>
                    @if (isLongDesc)
                    {
                        <button id="toggleDescBtn" type="button" class="btn-link-toggle">
                            Devamını Oku <i class="bi bi-chevron-down"></i>
                        </button>
                    }
                </div>

                <div class="detail-stats-grid mb-3">
                    <div class="detail-stat-item">
                        <i class="bi bi-people-fill"></i>
                        <span class="detail-stat-label">Oyuncu Sayısı</span>
                        <strong>@game.MinPlayers - @game.MaxPlayers Kişi</strong>
                    </div>
                    <div class="detail-stat-item">
                        <i class="bi bi-clock"></i>
                        <span class="detail-stat-label">Oyun Süresi</span>
                        <strong>@game.PlayTimeMinutes dk</strong>
                    </div>
                    <div class="detail-stat-item">
                        <i class="bi bi-box-seam"></i>
                        <span class="detail-stat-label">Stok Durumu</span>
                        <strong>@game.AvailableCopies / @game.TotalCopies Kopya</strong>
                        <div class="stock-progress mt-1">
                            <div class="stock-progress-bar @(inStock ? "" : "stock-progress-empty")"
                                 style="width: @stockPercent%"></div>
                        </div>
                    </div>
                </div>

                @if (hasWiki && wikiUrl != null)
                {
                    <div class="wiki-source-box mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-globe2 fs-5"></i>
                            <div>
                                <div class="fw-bold">Wikipedia / Wikidata Kaynağı</div>
                                <small class="text-muted">Oyun bilgileri harici API üzerinden sağlanmıştır.</small>
                            </div>
                        </div>
                        <a href="@wikiUrl" target="_blank" rel="noopener noreferrer" class="btn-wiki-link">
                            Kaynağa Git <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    </div>
                }

                <div class="d-flex flex-wrap align-items-center gap-2 mt-auto pt-2">
                    <a class="btn-color-detail btn-shape m-0 px-3 text-decoration-none d-inline-flex align-items-center gap-2" asp-page="/Rezervasyon">
                        <i class="bi bi-calendar-check"></i> Masa Rezerve Et
                    </a>
                    <a class="btn-color-detail btn-shape m-0 px-3 text-decoration-none d-inline-flex align-items-center gap-2" asp-page="/Oyunlar">
                        <i class="bi bi-arrow-left"></i> Kütüphaneye Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
}
