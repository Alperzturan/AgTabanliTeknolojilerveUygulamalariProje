@page
@model Michelangelo_s_Board_Game_Cafe.Pages.ProfilModel
@{
    ViewData["Title"] = "Profil";
}

<div class="d-flex flex-row flex-wrap justify-content-center gap-4 my-4">
    <div class="profile-box">
        <h4 class="d-flex justify-content-center">@Model.CurrentUser?.FullName</h4>
        <p><strong>E-mail: </strong>@Model.CurrentUser?.Email</p>
        <p><strong>Telefon Numarası: </strong>@(Model.CurrentUser?.PhoneNumber ?? "Belirtilmemiş")</p>
        <p><strong>Kayıt Tarihi: </strong>@Model.CurrentUser?.CreatedAt.ToString("dd.MM.yyyy")</p>
        <p><strong>Rol: </strong>@string.Join(", ", Model.Roles)</p>
        <form class="d-flex justify-content-center" method="post" asp-page-handler="Logout">
            <button type="submit" class="btn-shape btn-color-profile">Çıkış Yap</button>
        </form>
    </div>
    <div class="profile-box">
        <p>aktifrezervasyonalarım</p>
        <p>tarih saat</p>
        <p>masa</p>
        <p>oyunlar</p>
        <p>rezervasyon durumu</p> 
        <button>rezervasyon al</button>
    </div>
</div>

